# ══════════════════════════════════════════════════════════════════════
# ARCHITECTURE
# ══════════════════════════════════════════════════════════════════════
BR2_aarch64=y
BR2_cortex_a76=y
BR2_ARM64_PAGE_SIZE_4K=y
BR2_ARM_FPU_VFPV4=y

# ══════════════════════════════════════════════════════════════════════
# TOOLCHAIN
# ══════════════════════════════════════════════════════════════════════
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_AARCH64_GLIBC_STABLE=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y

# ══════════════════════════════════════════════════════════════════════
# SYSTEM
# ══════════════════════════════════════════════════════════════════════
BR2_TARGET_GENERIC_HOSTNAME="rpi5-tinkerlab-platform"
BR2_TARGET_GENERIC_ISSUE="Homelab Infrastructure Node"
BR2_INIT_SYSTEMD=y
BR2_SYSTEM_DHCP="eth0"
BR2_TARGET_TZ_INFO=y
BR2_TARGET_LOCALTIME="US/Central"

# ══════════════════════════════════════════════════════════════════════
# KERNEL
# ══════════════════════════════════════════════════════════════════════
BR2_LINUX_KERNEL=y
BR2_KERNEL_HEADERS_AS_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="https://github.com/raspberrypi/linux/archive/refs/heads/rpi-6.12.y.tar.gz"
BR2_LINUX_KERNEL_DEFCONFIG="bcm2712"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="broadcom/bcm2712-rpi-5-b"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_HOMELAB_PATH)/board/rpi5/kernel.fragment"

# ══════════════════════════════════════════════════════════════════════
# FIRMWARE
# ══════════════════════════════════════════════════════════════════════
BR2_PACKAGE_RPI_FIRMWARE=y
BR2_PACKAGE_RPI_FIRMWARE_VARIANT_PI=y
BR2_PACKAGE_RPI_FIRMWARE_INSTALL_DTB=y
BR2_PACKAGE_RPI_FIRMWARE_INSTALL_DTBO=y

# ══════════════════════════════════════════════════════════════════════
# FILESYSTEM
# ══════════════════════════════════════════════════════════════════════
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="2G"
BR2_TARGET_ROOTFS_TAR=y
BR2_TARGET_ROOTFS_TAR_GZIP=y

# Image generation
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_HOMELAB_PATH)/board/rpi5/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_HOMELAB_PATH)/board/rpi5/post-image.sh"
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_MTOOLS=y

# ══════════════════════════════════════════════════════════════════════
# PACKAGES - Docker & Container Support
# ══════════════════════════════════════════════════════════════════════
BR2_PACKAGE_DOCKER_CLI=y
BR2_PACKAGE_DOCKER_ENGINE=y
BR2_PACKAGE_CONTAINERD=y
BR2_PACKAGE_RUNC=y
BR2_PACKAGE_DOCKER_COMPOSE=y
BR2_PACKAGE_IPTABLES=y
BR2_PACKAGE_BRIDGE_UTILS=y

# ══════════════════════════════════════════════════════════════════════
# PACKAGES - Networking
# ══════════════════════════════════════════════════════════════════════
BR2_PACKAGE_DHCPCD=y
BR2_PACKAGE_OPENSSH=y
BR2_PACKAGE_NFS_UTILS=y
BR2_PACKAGE_IPROUTE2=y
BR2_PACKAGE_IPUTILS=y
BR2_PACKAGE_ETHTOOL=y
BR2_PACKAGE_AVAHI=y
BR2_PACKAGE_AVAHI_DAEMON=y
BR2_PACKAGE_BIND_TOOLS=y

# ══════════════════════════════════════════════════════════════════════
# PACKAGES - Utilities
# ══════════════════════════════════════════════════════════════════════
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_PROCPS_NG=y
BR2_PACKAGE_HTOP=y
BR2_PACKAGE_NANO=y
BR2_PACKAGE_LESS=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBCURL_CURL=y
BR2_PACKAGE_WGET=y
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_TAR=y
BR2_PACKAGE_XZ=y
BR2_PACKAGE_ZSTD=y

# ══════════════════════════════════════════════════════════════════════
# PACKAGES - Python (for Ansible)
# ══════════════════════════════════════════════════════════════════════
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_PYTHON3_SSL=y

# ══════════════════════════════════════════════════════════════════════
# PACKAGES - Pi Specific
# ══════════════════════════════════════════════════════════════════════
BR2_PACKAGE_RPI_USERLAND=y

# ══════════════════════════════════════════════════════════════════════
# OVERLAY
# ══════════════════════════════════════════════════════════════════════
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_HOMELAB_PATH)/overlay"